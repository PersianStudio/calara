{
  "name": "@persianstudio/calara",
  "version": "0.1.0",
  "description": "React calendar & date picker library — day/week/month boards, mini calendar, drawers, react-datepicker field. MIT. Extracted for Persian Studio.",
  "license": "MIT",
  "author": "Persian Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PersianStudio/calara.git"
  },
  "homepage": "https://persianstudio.github.io/calara/",
  "bugs": {
    "url": "https://github.com/PersianStudio/calara/issues"
  },
  "keywords": [
    "react",
    "calendar",
    "date-picker",
    "datepicker",
    "scheduler",
    "mui",
    "react-datepicker",
    "date-fns",
    "typescript",
    "persian-studio",
    "calara"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/calara.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "clean": "rm -rf dist showcase-dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "build": "pnpm clean && vite build",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/poppins": "^5.1.0",
    "@mui/material": "^5.15.18",
    "@mui/system": "^5.15.15",
    "@mui/types": "7.4.1",
    "@mui/utils": "5.17.1",
    "@mui/x-date-pickers": "7.3.1",
    "classnames": "2.5.1",
    "date-fns": "3.6.0",
    "i18next": "^23.11.5",
    "moment": "2.30.1",
    "react-country-flag": "^3.1.0",
    "react-datepicker": "^7.5.0",
    "react-hook-form": "^7.51.5",
    "react-i18next": "^14.1.2",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3"
  },
  "packageManager": "pnpm@9.15.0"
}
