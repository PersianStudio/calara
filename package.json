{
  "name": "@persianstudio/calara",
  "version": "0.3.0",
  "description": "Zero-dependency React calendar & date picker (React peers only). Day/week/month boards, mini calendar, local date core, plain HTML/CSS.",
  "license": "MIT",
  "author": "Persian Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PersianStudio/calara.git"
  },
  "homepage": "https://persianstudio.github.io/calara/docs/",
  "bugs": {
    "url": "https://github.com/PersianStudio/calara/issues"
  },
  "keywords": [
    "react",
    "calendar",
    "date-picker",
    "datepicker",
    "scheduler",
    "zero-dependency",
    "typescript",
    "persian-studio",
    "calara"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/calara.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "clean": "rm -rf dist showcase-dist docs-dist pages-dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "build": "pnpm clean && vite build",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "docs:dev": "vitepress dev docs --port 5182",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4182",
    "build:pages": "pnpm build && pnpm build:showcase && pnpm docs:build && node scripts/assemble-pages.mjs",
    "preview": "vite preview --config vite.showcase.config.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.2.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@9.15.0"
}
